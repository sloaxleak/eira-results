APP_NAME="EIRA Resultados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En piloto (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- EIRA Resultados -------------------------------------------------------

# Disco de documentos: "local" (storage/app/private, nunca público) o "s3" (bucket privado).
EIRA_DOCUMENTS_DISK=local
EIRA_UPLOAD_MAX_KB=10240

# Código de un solo uso y sesión de paciente. 10080 min = 7 días (decisión de EIRA).
EIRA_OTP_TTL_MINUTES=10080
EIRA_OTP_MAX_ATTEMPTS=5
EIRA_OTP_RESEND_COOLDOWN=60
EIRA_PATIENT_SESSION_MINUTES=20
EIRA_PORTAL_URL="${APP_URL}/consulta"

# Correo: "fake" (simulado) o "resend" (requiere API key y remitente de dominio verificado).
EIRA_EMAIL_DRIVER=fake
RESEND_API_KEY=
RESEND_FROM=

# SMS: "fake" (simulado), "disabled" o "clicksend" (real; credenciales solo en .env, nunca en el repo).
SMS_DRIVER=fake
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Opcional: Sender ID o número propio; vacío usa el remitente por defecto de la cuenta.
CLICKSEND_FROM=

# Bandeja simulada para ver en la demo los avisos de transportes fake. Nunca en producción.
EIRA_DEMO_OUTBOX=true

# Cambio rápido entre cuentas DEMO sin contraseña (solo demo; nunca en producción).
EIRA_DEMO_QUICK_LOGIN=false

# Opcional: correo propio de prueba para el estudio DEMO 0001 al sembrar (con EIRA_EMAIL_DRIVER=resend).
EIRA_DEMO_CONTACT_EMAIL=

# S3 privado (solo si EIRA_DOCUMENTS_DISK=s3). Credenciales fuera del repositorio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# true: confirmar la revisión publica y notifica en un solo paso (sin cuenta de publicación separada).
EIRA_PUBLISH_ON_REVIEW=false
